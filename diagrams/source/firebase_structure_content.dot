digraph G {
  graph [fontname="Garuda", fontsize=13, bgcolor="white", pad=0.25, nodesep=0.28, ranksep=0.42];
  node  [fontname="Garuda", fontsize=12, shape=box, style="rounded,filled", fillcolor="white", color="#4B5563", penwidth=1.4, margin="0.14,0.06"];
  edge  [fontname="Garuda", fontsize=11, color="#4B5563", arrowsize=0.7, penwidth=1.2];
  rankdir=LR; nodesep=0.22; ranksep=0.8; node [shape=plain, style=""];
  labelloc=t; label="(ก) ข้อมูลเนื้อหา : นำเข้าจาก nutriplan-firebase.json · ทุกคนอ่านได้ · แก้ไขได้เฉพาะผู้ดูแลข้อมูล"; fontsize=13;
  root [shape=circle, style="filled", fillcolor="#111827", fontcolor="white", label="root", width=0.7];
  menus [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>menus / {menu_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">menu_001 … menu_049  (49 รายการ)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">name_th, name_en : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">category_id : String → categories</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">vendor_type_id : String → vendor_types</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">serving_desc : String · serving_g : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">price_thb : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">energy_kcal, protein_g, fat_g, carb_g : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">sugar_g, fiber_g, sodium_mg : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">is_vegetarian : Boolean · spicy_level : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">tags : Array&lt;String&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">image_thumb, image_detail : String (Path)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">source_id : String → sources</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">verification_status : String · updated_at : String</FONT></TD></TR></TABLE>>]; cats [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>categories / {category_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">cat_rice … cat_side  (8 หมวด)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">name_th, name_en, description : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">icon : String (Path) · color : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">sort_order, menu_count : Number</FONT></TD></TR></TABLE>>]; arts [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>articles / {article_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">article_01 … article_12  (12 เรื่อง)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">title_th, title_en, topic, summary : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">key_points : Array&lt;String&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">source_ids : Array&lt;String&gt; → sources</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">related_nutrient : String → nutrient_limits</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">reading_minutes : Number · cover_image : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">status, published_at : String</FONT></TD></TR></TABLE>>]; lims [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>nutrient_limits / {nutrient_key}</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">energy_kcal … sodium_mg  (7 รายการ)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">name_th, name_en, unit : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">limit_type : String (personal|per_kg|max|min|info)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">limit_value, sort_order : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">source_id → sources · article_id → articles</FONT></TD></TR></TABLE>>]; small [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>ค่ามาตรฐานอื่น</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">โหนดขนาดเล็ก ใช้แสดงตัวเลือกและอ้างอิง</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">vendor_types / {vendor_type_id}  (7)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">activity_levels / {activity_id} : pal_factor  (5)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">health_goals / {goal_id} : kcal_adjust  (3)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">sources / {source_id}  (12)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">meta : schema_version, data_updated_at</FONT></TD></TR></TABLE>>];
  root -> cats; root -> menus; root -> lims; root -> arts; root -> small;
  { rank=same; cats; menus; lims; arts; small; }
  edge [style=dashed, color="#6B7280", arrowhead=vee, fontsize=10];
  menus -> cats [label=" category_id"]; lims -> arts [label=" article_id"];
}