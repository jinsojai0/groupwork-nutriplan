digraph G {
  graph [fontname="Garuda", fontsize=13, bgcolor="white", pad=0.25, nodesep=0.28, ranksep=0.42];
  node  [fontname="Garuda", fontsize=12, shape=box, style="rounded,filled", fillcolor="white", color="#4B5563", penwidth=1.4, margin="0.14,0.06"];
  edge  [fontname="Garuda", fontsize=11, color="#4B5563", arrowsize=0.7, penwidth=1.2];
  rankdir=LR; nodesep=0.22; ranksep=0.7; node [shape=plain, style=""];
  root [shape=circle, style="filled", fillcolor="#111827", fontcolor="white", label="root", width=0.7];
  subgraph cluster_pub { label="ข้อมูลเนื้อหา  (นำเข้าจาก nutriplan-firebase.json · ทุกคนอ่านได้ · แก้ไขได้เฉพาะผู้ดูแลข้อมูล)"; fontsize=12; style="rounded,dashed"; color="#1F4E79";
    menus [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>menus / {menu_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">menu_001 … menu_049  (49 รายการ)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">name_th, name_en : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">category_id : String → categories</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">vendor_type_id : String → vendor_types</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">serving_desc : String · serving_g : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">price_thb : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">energy_kcal, protein_g, fat_g, carb_g : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">sugar_g, fiber_g, sodium_mg : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">is_vegetarian : Boolean · spicy_level : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">tags : Array&lt;String&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">image_thumb, image_detail : String (Path)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">source_id : String → sources</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">verification_status : String · updated_at : String</FONT></TD></TR></TABLE>>];
    cats [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>categories / {category_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">cat_rice … cat_side  (8 หมวด)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">name_th, name_en, description : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">icon : String (Path) · color : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">sort_order, menu_count : Number</FONT></TD></TR></TABLE>>];
    arts [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>articles / {article_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">article_01 … article_12  (12 เรื่อง)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">title_th, title_en, topic, summary : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">key_points : Array&lt;String&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">source_ids : Array&lt;String&gt; → sources</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">related_nutrient : String → nutrient_limits</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">reading_minutes : Number · cover_image : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">status, published_at : String</FONT></TD></TR></TABLE>>];
    lims [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>nutrient_limits / {nutrient_key}</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">energy_kcal … sodium_mg  (7 รายการ)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">name_th, name_en, unit : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">limit_type : String (personal|per_kg|max|min|info)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">limit_value, sort_order : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">source_id → sources · article_id → articles</FONT></TD></TR></TABLE>>];
    small [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79" BGCOLOR="white"><TR><TD BGCOLOR="#1F4E79" ALIGN="LEFT"><FONT COLOR="white"><B>ค่ามาตรฐานอื่น</B></FONT></TD></TR><TR><TD BGCOLOR="#E8EEF5" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">โหนดขนาดเล็ก ใช้แสดงตัวเลือกและอ้างอิง</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">vendor_types / {vendor_type_id}  (7)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">activity_levels / {activity_id} : pal_factor  (5)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">health_goals / {goal_id} : kcal_adjust  (3)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">sources / {source_id}  (12)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">meta : schema_version, data_updated_at</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_usr { label="ข้อมูลผู้ใช้  (สร้างขณะใช้งาน · Key คือ uid จาก Firebase Authentication · อ่าน/เขียนได้เฉพาะเจ้าของ)"; fontsize=12; style="rounded,dashed"; color="#7C3AED";
    users [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>users / {uid}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">โปรไฟล์และเป้าหมายรายบุคคล</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">display_name, email, created_at : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">profile / sex, birth_year, height_cm, weight_kg,</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">      activity_id → activity_levels, goal_id → health_goals,</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">      budget_per_day_thb</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">targets / bmr, tdee, target_kcal, protein_g, updated_at</FONT></TD></TR></TABLE>>];
    logs [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>meal_logs / {uid} / {YYYY-MM-DD} / {log_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">จัดกลุ่มตามผู้ใช้และวัน อ่านทั้งวันได้ในคำขอเดียว</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">menu_id : String → menus</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">meal_type : String (breakfast|lunch|dinner|snack)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">qty : Number · logged_at : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">snapshot / name_th, energy_kcal, protein_g, sugar_g,</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">      fiber_g, sodium_mg, price_thb  (สำเนา ณ เวลาบันทึก)</FONT></TD></TR></TABLE>>];
    plans [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>meal_plans / {uid} / {YYYY-MM-DD}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">แผนที่ผู้ใช้เลือกบันทึก</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">slots / breakfast, lunch, dinner, snack : Array&lt;menu_id&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">total_kcal, total_sodium_mg, total_price : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">created_at : String</FONT></TD></TR></TABLE>>];
    favs [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>favorites / {uid} / {menu_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">เมนูโปรด (Index แบบ Key)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">true : Boolean</FONT></TD></TR></TABLE>>];
    roles [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>roles / {uid}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">สิทธิ์ผู้ใช้ กำหนดโดยผู้ดูแลระบบเท่านั้น</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">"member" | "editor" | "admin" : String</FONT></TD></TR></TABLE>>];
  }
  root -> menus; root -> cats; root -> arts; root -> lims; root -> small;
  root -> users; root -> logs; root -> plans; root -> favs; root -> roles;
  edge [style=dashed, color="#9CA3AF", constraint=false, arrowhead=vee];
  menus -> cats [label=" category_id"]; logs -> menus [label=" menu_id"]; favs -> menus; lims -> arts [label=" article_id"];
  plans -> menus;
}