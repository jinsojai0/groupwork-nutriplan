digraph G {
  graph [fontname="Garuda", fontsize=13, bgcolor="white", pad=0.25, nodesep=0.28, ranksep=0.42];
  node  [fontname="Garuda", fontsize=12, shape=box, style="rounded,filled", fillcolor="white", color="#4B5563", penwidth=1.4, margin="0.14,0.06"];
  edge  [fontname="Garuda", fontsize=11, color="#4B5563", arrowsize=0.7, penwidth=1.2];
  rankdir=LR; nodesep=0.22; ranksep=0.8; node [shape=plain, style=""];
  labelloc=t; label="(ข) ข้อมูลผู้ใช้ : สร้างขณะใช้งาน · Key ระดับแรกคือ uid จาก Firebase Authentication · อ่าน/เขียนได้เฉพาะเจ้าของ"; fontsize=13;
  root [shape=circle, style="filled", fillcolor="#111827", fontcolor="white", label="root", width=0.7];
  users [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>users / {uid}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">โปรไฟล์และเป้าหมายรายบุคคล</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">display_name, email, created_at : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">profile / sex, birth_year, height_cm, weight_kg,</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">      activity_id → activity_levels, goal_id → health_goals,</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">      budget_per_day_thb</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">targets / bmr, tdee, target_kcal, protein_g, updated_at</FONT></TD></TR></TABLE>>]; logs [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>meal_logs / {uid} / {YYYY-MM-DD} / {log_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">จัดกลุ่มตามผู้ใช้และวัน อ่านทั้งวันได้ในคำขอเดียว</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">menu_id : String → menus</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">meal_type : String (breakfast|lunch|dinner|snack)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">qty : Number · logged_at : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">snapshot / name_th, energy_kcal, protein_g, sugar_g,</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">      fiber_g, sodium_mg, price_thb  (สำเนา ณ เวลาบันทึก)</FONT></TD></TR></TABLE>>]; plans [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>meal_plans / {uid} / {YYYY-MM-DD}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">แผนที่ผู้ใช้เลือกบันทึก</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">slots / breakfast, lunch, dinner, snack : Array&lt;menu_id&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">total_kcal, total_sodium_mg, total_price : Number</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">created_at : String</FONT></TD></TR></TABLE>>]; favs [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>favorites / {uid} / {menu_id}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">เมนูโปรด (Index แบบ Key)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">true : Boolean</FONT></TD></TR></TABLE>>]; roles [label=<<TABLE BORDER="1.4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C3AED" BGCOLOR="white"><TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="white"><B>roles / {uid}</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E8FF" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#374151">สิทธิ์ผู้ใช้ กำหนดโดยผู้ดูแลระบบเท่านั้น</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10.5">"member" | "editor" | "admin" : String</FONT></TD></TR></TABLE>>];
  mstub [shape=box, style="rounded,dashed", label="menus / {menu_id}\n(ดูภาพ ก)", fontsize=11, color="#1F4E79"];
  root -> users; root -> logs; root -> plans; root -> favs; root -> roles;
  edge [style=dashed, color="#6B7280", arrowhead=vee, fontsize=10];
  logs -> mstub [label=" menu_id"]; plans -> mstub; favs -> mstub [label=" key"];
}