  "articles": {
    "article_01": {
      "title_th": "พลังงานที่ร่างกายต้องการต่อวันคำนวณอย่างไร",
      "title_en": "How to Calculate Your Daily Energy Needs",
      "topic": "basic",
      "summary": "อธิบายความหมายของ BMR และ TDEE พร้อมวิธีคำนวณด้วยสมการ Mifflin-St Jeor",
      "key_points": [
        "BMR คือพลังงานที่ร่างกายใช้ขณะพักเพื่อรักษาการทำงานพื้นฐาน เช่น การหายใจและการเต้นของหัวใจ",
        "สมการ Mifflin-St Jeor สำหรับเพศชาย BMR = 10 × น้ำหนัก (กก.) + 6.25 × ส่วนสูง (ซม.) − 5 × อายุ (ปี) + 5 ส่วนเพศหญิงใช้ −161 แทน +5",
        "TDEE คือ BMR คูณตัวคูณระดับกิจกรรม ตั้งแต่ 1.2 สำหรับผู้ที่นั่งทำงานเป็นหลัก ถึง 1.9 สำหรับผู้ใช้แรงงานหนัก",
        "ตัวเลขที่ได้เป็นค่าประมาณเพื่อใช้วางแผน ไม่ใช่ค่าที่วัดได้จริงของแต่ละบุคคล"
      ],
      "source_ids": [
        "src_05",
        "src_02"
      ],
      "related_nutrient": "energy_kcal",
      "reading_minutes": 4,
      "cover_image": "images/articles/article_01_cover.webp",
      "status": "PUBLISHED",
      "published_at": "2026-09-20"
    },
    "article_03": {
      "title_th": "โซเดียมแฝงในอาหารจานเดียวของไทย",
      "title_en": "Hidden Sodium in Thai Single-dish Meals",
      "topic": "sodium",
      "summary": "เปรียบเทียบปริมาณโซเดียมของเมนูยอดนิยมกับเกณฑ์ไม่เกิน 2,000 มิลลิกรัมต่อวัน",
      "key_points": [
        "องค์การอนามัยโลกแนะนำให้ผู้ใหญ่บริโภคโซเดียมไม่เกิน 2,000 มิลลิกรัมต่อวัน ซึ่งเทียบเท่าเกลือประมาณ 5 กรัม",
        "กรมอนามัยรายงานว่าคนไทยได้รับโซเดียมเฉลี่ย 3,636 มิลลิกรัมต่อวัน เกือบสองเท่าของเกณฑ์",
        "โซเดียมส่วนใหญ่มาจากน้ำปลา ซีอิ๊ว ซอสปรุงรส ผงปรุงรส และน้ำซุป ก๋วยเตี๋ยวน้ำหนึ่งชามจึงอาจให้โซเดียมเกือบทั้งวัน",
        "วิธีลดที่ทำได้ทันทีคือไม่ซดน้ำซุปจนหมด ชิมก่อนเติมเครื่องปรุง และสลับเมนูรสจัดกับผัดผักหรือแกงจืด"
      ],
      "source_ids": [
        "src_03",
        "src_16",
        "src_01"
      ],
      "related_nutrient": "sodium_mg",
      "reading_minutes": 5,
      "cover_image": "images/articles/article_03_cover.webp",
      "status": "PUBLISHED",
      "published_at": "2026-09-20"
    },
    "article_04": {
      "title_th": "น้ำตาลในเครื่องดื่ม หนึ่งแก้วเท่ากับกี่ช้อนชา",
      "title_en": "Sugar in Beverages",
      "topic": "sugar",
      "summary": "แปลงปริมาณน้ำตาลในเครื่องดื่มเป็นจำนวนช้อนชาเพื่อให้เห็นภาพ",
      "key_points": [
        "องค์การอนามัยโลกแนะนำให้ได้รับน้ำตาลอิสระน้อยกว่าร้อยละ 10 ของพลังงานทั้งวัน สำหรับผู้ที่ต้องการ 2,000 กิโลแคลอรีคือไม่เกินประมาณ 50 กรัม และจะดียิ่งขึ้นหากต่ำกว่าร้อยละ 5",
        "น้ำตาล 1 ช้อนชามีประมาณ 4 กรัม ชาไทยเย็นหนึ่งแก้วในระบบมีน้ำตาลประมาณ 44 กรัม หรือราว 11 ช้อนชา",
        "การสั่งหวานน้อย หรือเปลี่ยนเป็นน้ำเปล่าและนมถั่วเหลืองสูตรหวานน้อย ช่วยลดน้ำตาลได้มากโดยไม่ต้องเปลี่ยนมื้ออาหาร"
      ],
      "source_ids": [
        "src_04",
        "src_01"
      ],
      "related_nutrient": "sugar_g",
      "reading_minutes": 4,
      "cover_image": "images/articles/article_04_cover.webp",
      "status": "PUBLISHED",
      "published_at": "2026-09-20"
    }
